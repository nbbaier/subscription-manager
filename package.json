		"date-fns": "^3.0.0",
		"drizzle-orm": "^0.30.0",
		"nanoid": "^5.0.4",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"tailwindcss": "^4.1.18"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@types/bun": "latest",
		"@types/chrome": "^0.1.32",
		"@types/node": "^25.0.3",
		"@types/react": "^19.2.7",
