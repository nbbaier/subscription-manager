{
	"name": "subscription-manager",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:api": "bun run --watch app/index.ts",
		"build": "vite build",
		"start": "node .output/server/index.mjs",
		"db:generate": "drizzle-kit generate",
